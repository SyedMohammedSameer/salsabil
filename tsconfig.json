{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "netlify/functions"],
  // *.native.ts are the React Native halves of the platform adapters. Their
  // dependencies live in mobile/, and Vite never resolves them, so they are
  // type-checked by mobile/tsconfig.json instead.
  "exclude": ["node_modules", "dist", "src/**/*.native.ts", "src/**/*.native.tsx"]
}
