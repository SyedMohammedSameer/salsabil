# Mobile app environment.
#
# EXPO_PUBLIC_* variables are inlined into the JavaScript bundle at build time,
# so treat them as public. Never put a service role key or any secret here —
# the anon key is safe because Supabase row-level security enforces access.
#
# For EAS builds set these as secrets instead:
#   eas secret:create --name EXPO_PUBLIC_SUPABASE_URL --value "https://..."

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin of the deployed web app, used to reach the Netlify functions
# (ai-chat, tts, prayer-times). No trailing slash.
EXPO_PUBLIC_API_BASE_URL=https://your-site.netlify.app

# Set automatically by `eas init`; only needed for EAS builds.
EAS_PROJECT_ID=
